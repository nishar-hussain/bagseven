# AgentOS local development environment (values shown are dev defaults)
DATABASE_URL=postgres://agentos:agentos@localhost:5432/agentos
REDIS_URL=redis://localhost:6379

# Service ports
GATEWAY_PORT=4000
IDENTITY_PORT=4001
TREASURY_PORT=4002
POLICY_PORT=4003
VERIFICATION_PORT=4004

# Upstream routing (gateway)
IDENTITY_URL=http://localhost:4001
TREASURY_URL=http://localhost:4002
POLICY_URL=http://localhost:4003
VERIFICATION_URL=http://localhost:4004

# Chains supported by the treasury dev signer
SUPPORTED_CHAINS=base-sepolia

# Dev faucet on
DEV_MODE=true

# Generate a policy signing keypair with:
#   pnpm --filter @agentos/db exec tsx ../scripts/gen-policy-key.ts
# or start policy once (dev mode) and copy the logged public key here.
POLICY_SIGNING_PRIVATE_KEY_PEM=
POLICY_SIGNING_PUBLIC_KEY_PEM=