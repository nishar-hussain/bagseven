# AgentOS local development environment (values shown are dev defaults)
DATABASE_URL=postgres://agentos:agentos@localhost:5432/agentos
REDIS_URL=redis://localhost:6379

# Service ports
GATEWAY_PORT=4000
IDENTITY_PORT=4001
TREASURY_PORT=4002
POLICY_PORT=4003
VERIFICATION_PORT=4004
MARKETPLACE_PORT=4005
PAYMENTS_PORT=4006
DEMO_PROVIDER_PORT=4007
MCP_PORT=4008

# Upstream routing (gateway)
IDENTITY_URL=http://localhost:4001
TREASURY_URL=http://localhost:4002
POLICY_URL=http://localhost:4003
VERIFICATION_URL=http://localhost:4004
MARKETPLACE_URL=http://localhost:4005
PAYMENTS_URL=http://localhost:4006

# Chains supported by the treasury dev signer
SUPPORTED_CHAINS=sepolia

# Dev faucet on
DEV_MODE=true

# --- Real on-chain signer (slice 1.6) -----------------------------------------
# SIGNER_MODE=dev | real    (dev fabricates addresses/txs; real broadcasts on-chain)
SIGNER_MODE=dev
# Required when SIGNER_MODE=real:
#   TREASURY_AGENT_SEED         secret used to derive a real EOA per agent
#   TREASURY_MASTER_PRIVATE_KEY 0x-prefixed key holding testnet ETH + USDC
#                               (funds agents on credit; agents pay their own gas)
#   SEPOLIA_RPC_URL             https://ethereum-sepolia-rpc.publicnode.com (or http://localhost:8545 for anvil)
#   SEPOLIA_USDC                0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238 (Circle testnet USDC on Sepolia)
#   GAS_GRANT_NATIVE            0.01  (native gas sent alongside each token credit)
#   PLATFORM_MAX_TOTAL_SPEND    hard cap on cumulative real settlement (guarded signing), e.g. 5.00
#   GAS_GRANT_NATIVE            0.01  (native gas sent alongside each token credit)

# Generate a policy signing keypair with:
#   pnpm --filter @agentos/db exec tsx ../scripts/gen-policy-key.ts
# or start policy once (dev mode) and copy the logged public key here.
POLICY_SIGNING_PRIVATE_KEY_PEM=
POLICY_SIGNING_PUBLIC_KEY_PEM=