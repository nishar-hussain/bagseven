{
  "name": "bagseven",
  "version": "0.1.0",
  "private": true,
  "description": "Bagseven — infrastructure for autonomous AI agents: identity, policy, treasury, marketplaces, and controlled execution",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "bagseven-mcp": "tsx scripts/bagseven-mcp.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "test:mcp-config": "vitest run --config vitest.local.config.ts",
    "bagseven-daemon": "pnpm --filter @bagseven/daemon start",
    "research-provider": "pnpm --filter @bagseven/research-provider dev",
    "research-demo": "pnpm --filter @bagseven/research-demo dev",
    "demo:research": "tsx scripts/research-demo.ts",
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f deploy/docker-compose.yml up -d",
    "db:down": "docker compose -f deploy/docker-compose.yml down",
    "db:migrate": "pnpm --filter @bagseven/db run migrate",
    "db:generate": "pnpm --filter @bagseven/db run generate",
    "db:studio": "pnpm --filter @bagseven/db run studio",
    "pm2:start": "pnpm exec pm2 start deploy/ecosystem.config.cjs",
    "pm2:stop": "pnpm exec pm2 stop deploy/ecosystem.config.cjs",
    "pm2:status": "pnpm exec pm2 status",
    "pm2:logs": "pnpm exec pm2 logs",
    "pm2:restart": "pnpm exec pm2 restart deploy/ecosystem.config.cjs"
  },
  "devDependencies": {
    "@bagseven/db": "workspace:*",
    "@bagseven/money": "workspace:*",
    "@bagseven/onchain": "workspace:*",
    "@bagseven/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.1",
    "eslint": "^10.10.0",
    "express": "^5.1.0",
    "pm2": "^7.0.4",
    "solc": "^0.8.37",
    "tsx": "^4.23.13",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "viem": "^2.56.8",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
